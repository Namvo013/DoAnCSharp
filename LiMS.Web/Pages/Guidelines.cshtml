@page
@model GuidelinesModel
@{
    ViewData["Title"] = "Hướng dẫn & Nội quy";
}

<div class="page-head"><div><span class="eyebrow">THÔNG TIN THƯ VIỆN</span><h1>Hướng dẫn &amp; Nội quy</h1><p>Quy định và hướng dẫn sử dụng dịch vụ thư viện LiMS.</p></div></div>
<section class="guidelines-intro"><div class="guideline-hero-icon">📘</div><div><strong>Mỗi quyển sách là một hành trình mới</strong><p>Vui lòng đọc kỹ hướng dẫn để đảm bảo quyền lợi của bạn và giữ tài liệu trong tình trạng tốt nhất cho cộng đồng.</p></div></section>
<section class="guideline-grid">
    <article><span>01</span><div><strong>Đăng ký thẻ thư viện</strong><p>Sử dụng mã sinh viên và hoàn tất xác thực tài khoản LiMS.</p></div></article>
    <article><span>02</span><div><strong>Mượn &amp; trả sách</strong><p>Kiểm tra hạn trả, gia hạn khi được phép và trả đúng vị trí quy định.</p></div></article>
    <article><span>03</span><div><strong>Đặt giữ tài liệu</strong><p>Đặt giữ tài liệu và theo dõi thông báo của thư viện.</p></div></article>
    <article><span>04</span><div><strong>Bảo quản tài liệu</strong><p>Không viết, đánh dấu, làm rách hoặc mang tài liệu ra khỏi thư viện khi chưa mượn.</p></div></article>
</section>
<section class="rules-panel">
    <div class="rules-heading"><div><span class="eyebrow">NỘI QUY</span><h2>Quy định chung</h2></div></div>
    <div class="rules-list">
        <details open><summary>Thời gian mượn và gia hạn</summary><div><p>Độc giả thường được mượn tối đa 5 tài liệu trong thời hạn 14 ngày. Gia hạn cần tuân theo điều kiện của thư viện.</p></div></details>
        <details><summary>Quy định đặt giữ tài liệu</summary><div><p>Theo dõi hạn hiệu lực của phiếu và thông báo khi tài liệu sẵn sàng.</p></div></details>
        <details><summary>Bảo quản tài liệu</summary><div><p>Độc giả có trách nhiệm giữ tài liệu nguyên vẹn và hoàn trả đúng hạn.</p></div></details>
    </div>
</section>
