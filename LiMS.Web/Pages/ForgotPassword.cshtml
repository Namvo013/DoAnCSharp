@page
@{
    ViewData["Title"] = "Khôi phục mật khẩu";
}

<div class="simple-page">
    <section class="login-card recovery-card">
        <span class="eyebrow">HỖ TRỢ TÀI KHOẢN</span>
        <h2>Khôi phục mật khẩu</h2>
        <p>Để bảo vệ tài khoản độc giả, vui lòng liên hệ thủ thư để xác minh danh tính và được hỗ trợ đặt lại mật khẩu.</p>
        <div class="form-message warning" role="status">
            Khôi phục tự động qua email chưa khả dụng vì hệ thống chưa được cấu hình dịch vụ gửi thư.
        </div>
        <a class="primary recovery-back" asp-page="/Index">Quay lại đăng nhập</a>
    </section>
</div>
